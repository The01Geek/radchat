{
  "name": "radchat",
  "version": "0.1.0",
  "description": "An embeddable React chat widget for analytics and AI agents: floating, sidebar, and fullscreen layouts, drag and 8-way resize, Markdown, tables, charts, slash commands, and attachments. Connect it to any backend through a small data-source interface.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The01Geek/radchat.git"
  },
  "homepage": "https://github.com/The01Geek/radchat#readme",
  "bugs": {
    "url": "https://github.com/The01Geek/radchat/issues"
  },
  "keywords": [
    "react",
    "chat",
    "chat-widget",
    "chatbot",
    "ai",
    "agent",
    "analytics",
    "plotly",
    "markdown"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "LICENSES",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/radchat.js",
  "module": "./dist/radchat.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/radchat.js"
    },
    "./style.css": "./dist/radchat.css",
    "./standalone": "./dist/standalone/radchat.umd.js",
    "./standalone.css": "./dist/standalone/radchat.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "demo": "vite --config vite.demo.config.ts",
    "build": "npm run build:lib && npm run build:standalone && npm run build:demo",
    "build:lib": "vite build && tsc -p tsconfig.build.json && node scripts/strip-dts-css.mjs",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "prepare": "npm run build:lib && npm run build:standalone",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "plotly.js-basic-dist-min": "^3.3.1",
    "react-chatbot-kit": "^2.2.2",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "react-plotly.js": {
      "plotly.js": "npm:plotly.js-basic-dist-min@^3.3.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^25.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
